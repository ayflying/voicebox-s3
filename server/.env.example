# VoiceBox S3 服务端环境变量模板
# 复制为 .env 后，替换为高强度随机令牌；不要提交实际 .env 文件。

# 设备调用 /transcribe 与 /api/ota/* 时使用的令牌。
AUTH_TOKEN=replace-with-a-long-random-device-token

# 管理接口 /api/admin/ota/push 使用的独立令牌。
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Faster-Whisper 模型；当前编排默认值为 base-int8。
WHISPER_MODEL=base-int8
